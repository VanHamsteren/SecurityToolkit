{
    "manifest_version": 3,
    "name": "Security Toolkit",
    "short_name": "securitytoolkit",
    "author": "Paul Rutten",
    "version": "1.7.0",
    "description": "Right-click a link to analyse it with the built-in Quick Scan, urlscan.io, VirusTotal and AbuseIPDB in one results page. Then block the domains in NextDNS.",
    "permissions": [
        "contextMenus",
        "activeTab",
        "tabs",
        "storage",
        "notifications"
    ],
    "host_permissions": [
        "https://urlscan.io/*",
        "https://api.nextdns.io/*",
        "https://www.virustotal.com/*",
        "https://api.abuseipdb.com/*"
    ],
    "optional_permissions": [
        "webRequest",
        "webRequestBlocking"
    ],
    "optional_host_permissions": [
        "<all_urls>"
    ],
    "icons": {
        "16": "icons/icon_16.png",
        "32": "icons/icon_32.png",
        "48": "icons/icon_48.png",
        "96": "icons/icon_96.png",
        "128": "icons/icon_128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon_16.png",
            "32": "icons/icon_32.png",
            "48": "icons/icon_48.png",
            "96": "icons/icon_96.png"
        },
        "default_title": "Security Toolkit"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "background": {
        "scripts": [
            "quickscan.js",
            "background.js"
        ]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "firefox@paulrutten.nl",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": [
                    "authenticationInfo",
                    "browsingActivity"
                ]
            }
        }
    }
}